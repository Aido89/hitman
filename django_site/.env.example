# --- Keycloak / OIDC ---
OIDC_RP_CLIENT_ID=your-client-id
OIDC_RP_CLIENT_SECRET=your-client-secret
OIDC_OP_ISSUER=https://keycloak.example.com/realms/your-realm

# --- Уведомления о заявках ---
# Оба канала необязательны. Не задан — канал просто пропускается,
# заявка всё равно сохраняется. Задайте хотя бы один, иначе о новой
# заявке никто не узнает до открытия /admin/.
#
# Telegram: напишите @BotFather → /newbot → получите токен.
# chat_id: напишите боту любое сообщение, затем откройте
#   https://api.telegram.org/bot<ТОКЕН>/getUpdates и возьмите message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Почта для дублирования заявок
LEAD_NOTIFY_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@hitman.barysgame.kz

# --- Аналитика ---
# Пусто = скрипты вообще не подключаются (для локальной разработки).
# Метрика: https://metrika.yandex.ru → создать счётчик → взять номер.
YANDEX_METRIKA_ID=
PLAUSIBLE_DOMAIN=

# --- Прочее ---
SITE_URL=https://hitman.barysgame.kz
