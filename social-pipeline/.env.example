# ---- домены (A-записи должны смотреть на сервер)
POSTIZ_DOMAIN=post.aidyn.stream
N8N_DOMAIN=n8n.aidyn.stream
# необязательно: публичная раздача роликов (нужна для Instagram)
MEDIA_DOMAIN=
ACME_EMAIL=you@example.com

# ---- секреты: сгенерировать каждый через `openssl rand -hex 32`
POSTIZ_JWT_SECRET=
POSTIZ_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=
N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
# токен, которым защищён вебхук публикации в n8n
PIPELINE_WEBHOOK_TOKEN=

# ---- Postiz
# после регистрации своего аккаунта: true, и `docker compose up -d postiz`
POSTIZ_DISABLE_REGISTRATION=false
# ключ из Postiz: Settings -> Public API
POSTIZ_API_KEY=
POSTIZ_API_LIMIT=90

# ---- ключи площадок (см. README.md). Пустые = площадка выключена.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# Instagram через Facebook-страницу
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Instagram без Facebook (Instagram Login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TELEGRAM_TOKEN=
TELEGRAM_BOT_NAME=
THREADS_APP_ID=
THREADS_APP_SECRET=
VK_ID=
# необязательно: ИИ-подписи и картинки внутри Postiz
OPENAI_API_KEY=

# ---- контент-завод (content-factory/publish.py)
# локально: http://media ; на сервере: https://<MEDIA_DOMAIN>
MEDIA_BASE_URL=http://media
FACTORY_N8N_URL=http://localhost:5678
